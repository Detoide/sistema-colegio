<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="esAdmin" value="${usuarioActual.rol.nombreRol == 'ADMINISTRADOR' || usuarioActual.rol.nombreRol == 'DIRECTIVO'}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${empty pageTitle ? 'Prime School' : pageTitle}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/css/app.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light navbar-prime">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="${ctx}/">
            <img src="${ctx}/img/prime-school.svg" class="brand-logo" alt="Prime School">
            Prime School
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
            <c:if test="${not empty usuarioActual}">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="${ctx}/">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="${ctx}/matriculas">Matrículas</a></li>
                    <c:if test="${esAdmin}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/matriculas/nueva">Nueva matrícula</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/vacantes">Vacantes</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/estudiantes">Estudiantes</a></li>
                        <li class="nav-item"><a class="nav-link" href="${ctx}/apoderados">Apoderados</a></li>
                    </c:if>
                    <c:if test="${usuarioActual.rol.nombreRol != 'APODERADO'}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/registro-academico">Registro académico</a></li>
                    </c:if>
                    <li class="nav-item"><a class="nav-link" href="${ctx}/boletas">Boletas</a></li>
                    <li class="nav-item"><a class="nav-link" href="${ctx}/alertas">Alertas</a></li>
                    <c:if test="${esAdmin}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/admin/usuarios">Administración</a></li>
                    </c:if>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-secondary small">
                        <c:out value="${usuarioActual.nombreCompleto}"/>
                        <span class="badge text-bg-light ms-1"><c:out value="${usuarioActual.rol.nombreRol}"/></span>
                    </span>
                    <form method="post" action="${ctx}/logout" class="m-0">
                        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Salir</button>
                    </form>
                </div>
            </c:if>
        </div>
    </div>
</nav>
<div class="container mt-4">
    <c:if test="${not empty ok}">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <c:out value="${ok}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>
    <c:if test="${not empty error}">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <c:out value="${error}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </c:if>
